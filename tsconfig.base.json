{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/dashboard/src/*.ts", "apps/dashboard/src/*.tsx"],
      "@agency_hub_core/contracts": ["packages/contracts/src/index.ts"],
      "@agency_hub_core/shared": ["packages/shared/src/index.ts"],
      "@agency_hub_core/db": ["packages/db/src/index.ts"],
      "@agency_hub_core/fansly": ["packages/fansly/src/index.ts"],
      "@agency_hub_core/onlyfans": ["packages/onlyfans/src/index.ts"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
