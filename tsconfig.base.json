{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@fansly-connect/contracts": ["packages/contracts/src/index.ts"],
      "@fansly-connect/shared": ["packages/shared/src/index.ts"],
      "@fansly-connect/db": ["packages/db/src/index.ts"],
      "@fansly-connect/fansly": ["packages/fansly/src/index.ts"],
      "@fansly-connect/onlyfans": ["packages/onlyfans/src/index.ts"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
