# Agency Hub production template.
# Copy this file to .env.production, then replace the placeholder values before the first deploy.
# Keep API_PORT=3000 if you use docker-compose.production.yml without modification.
# Leave optional values blank to disable the related feature.

# POSTGRES_DB: bundled Postgres database name. Format: plain string. Default: agency_hub_core.
POSTGRES_DB=agency_hub_core

# POSTGRES_USER: bundled Postgres user name. Format: plain string. Default: postgres.
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: bundled Postgres password. Format: plain string. Default: none; set explicitly.
POSTGRES_PASSWORD=change-me

# DATABASE_URL: application database DSN for API, worker, CLI, and startup migrations. Format: postgres://USER:PASSWORD@HOST:PORT/DB. Default: none; required.
DATABASE_URL=postgres://postgres:change-me@postgres:5432/agency_hub_core

# APP_ENCRYPTION_KEY: write key for encrypted credentials and proxy secrets. Format: base64 that decodes to exactly 32 bytes. Default: none; required.
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-byte-key

# APP_ENCRYPTION_KEY_RING: optional legacy decrypt keys. Format: version:base64[,version:base64...]. Default: empty.
APP_ENCRYPTION_KEY_RING=

# APP_ENCRYPTION_KEY_VERSION: write-key version stored with new encrypted rows. Format: positive integer. Default: 1.
APP_ENCRYPTION_KEY_VERSION=1

# LOG_LEVEL: runtime log verbosity. Format: pino level string. Default: info.
LOG_LEVEL=info

# API_HOST: bind address inside the container. Format: host or IP string. Default: 0.0.0.0.
API_HOST=0.0.0.0

# API_PORT: HTTP port used by the API and same-origin dashboard. Format: positive integer. Default: 3000.
API_PORT=3000

# TRUST_PROXY: how much of the x-forwarded-* chain to trust when deriving
# request.ip (the login rate limiter keys on it). Format: false (no proxy,
# use the socket address) | true (trust the whole header chain — only safe if
# EVERY hop overwrites x-forwarded-for) | hop count | comma-separated IP/CIDR
# allowlist of proxies. Use 1 for the default production setup: exactly one
# TLS reverse proxy in front of the API. That proxy MUST append the real
# client address to x-forwarded-for (nginx: proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for; Caddy does this by default); client-supplied
# entries beyond the trusted hop are then ignored instead of spoofing the
# rate-limit key.
TRUST_PROXY=1

# SESSION_TTL_DAYS: dashboard session lifetime. Format: positive integer days. Default: 30.
SESSION_TTL_DAYS=30

# FANSLY_BASE_URL: Fansly API base URL. Format: absolute URL. Default: https://apiv3.fansly.com/api/v1.
FANSLY_BASE_URL=https://apiv3.fansly.com/api/v1

# SYNC_HTTP_TRACE_FILE: optional NDJSON request trace sink for sync HTTP telemetry. Format: writable file path inside the container. Default: empty.
SYNC_HTTP_TRACE_FILE=

# SYNC_HTTP_ATTEMPT_TRACE_STDOUT: verbose per-attempt sync HTTP traces on worker stdout. Format: true/false. Default: false. Off keeps retries, failures, and attempts whose DB telemetry row was lost; true restores the full feed (~400 MB/day of container logs). Applies after worker restart.
SYNC_HTTP_ATTEMPT_TRACE_STDOUT=false

# FANSLY_DEFAULT_DELAY_MS: primary per-request spacing for Fansly traffic. Format: positive integer milliseconds. Default: 1900.
FANSLY_DEFAULT_DELAY_MS=1900

# FANSLY_GLOBAL_DELAY_MS: deprecated fallback alias for FANSLY_DEFAULT_DELAY_MS. Format: positive integer milliseconds. Default: empty.
FANSLY_GLOBAL_DELAY_MS=

# FANSLY_ACCOUNT_LOOKUP_DELAY_MS: deprecated fallback alias kept for compatibility. Format: positive integer milliseconds. Default: empty.
FANSLY_ACCOUNT_LOOKUP_DELAY_MS=

# FOLLOWER_PAGE_DELAY_MS: delay between Fansly follower pages. Format: positive integer milliseconds. Default: 5000.
FOLLOWER_PAGE_DELAY_MS=5000

# FANSLY_DM_CONVERSATIONS_DELAY_MS: shared-rate-limit spacing for Fansly conversation syncs. Format: positive integer milliseconds. Default: 5000. Values below 5000 are raised to 5000.
FANSLY_DM_CONVERSATIONS_DELAY_MS=5000

# FANSLY_DM_MESSAGES_DELAY_MS: shared-rate-limit spacing for Fansly message syncs. Format: positive integer milliseconds. Default: 5000. Values below 5000 are raised to 5000.
FANSLY_DM_MESSAGES_DELAY_MS=5000

# FANSLY_DM_DEEP_BACKFILL_ENABLED: opt-in slow historical message backfill after live message work is exhausted. Format: true or false. Default: false.
FANSLY_DM_DEEP_BACKFILL_ENABLED=false

# FANSLY_DM_DEEP_BACKFILL_MAX_REQUESTS_PER_RUN: maximum historical message pages to fetch per dm_messages stream run when deep backfill is enabled. Format: non-negative integer. Default: 1.
FANSLY_DM_DEEP_BACKFILL_MAX_REQUESTS_PER_RUN=1

# FANSLY_DM_DEEP_BACKFILL_LIVE_REQUESTS_PER_DEEP: busy-account balance; after this many live message page requests, allow one deep page. Format: positive integer. Default: 4.
FANSLY_DM_DEEP_BACKFILL_LIVE_REQUESTS_PER_DEEP=4

# FANSLY_DM_DEEP_BACKFILL_CONTINUATION_DELAY_MS: idle deep-backfill delay between historical pages. Format: non-negative integer milliseconds. Default: 0.
FANSLY_DM_DEEP_BACKFILL_CONTINUATION_DELAY_MS=22000

# FANSLY_DM_DEEP_BACKFILL_CONTINUATION_JITTER_MS: random +/- jitter applied to idle deep-backfill continuation delay. Format: non-negative integer milliseconds. Default: 0.
FANSLY_DM_DEEP_BACKFILL_CONTINUATION_JITTER_MS=8000

# ONLYFANS_DEFAULT_DELAY_MS: baseline delay for OnlyFans adapter calls. Format: positive integer milliseconds. Default: 1000.
ONLYFANS_DEFAULT_DELAY_MS=1000

# SYNC_SHARED_RATE_LIMIT_ENABLED: enable shared Fansly pacing across workers/pages. Format: true or false. Runtime default: false. Recommended when executor concurrency is greater than 1.
SYNC_SHARED_RATE_LIMIT_ENABLED=true

# SYNC_PAGE_EXECUTOR_CONCURRENCY: number of pages the worker may execute in parallel. Format: positive integer. Default: 4.
SYNC_PAGE_EXECUTOR_CONCURRENCY=4

# TRANSACTION_LOOKBACK_DAYS: transaction resync lookback window. Format: positive integer days. Default: 7.
TRANSACTION_LOOKBACK_DAYS=7

# TRANSACTION_RESCAN_CAP_DAYS: maximum age of pending-aware transaction rescans. Format: positive integer days. Default: 30.
TRANSACTION_RESCAN_CAP_DAYS=30

# SYNC_OBSERVABILITY_RETENTION_DAYS: retention window for sync telemetry rows. Format: positive integer days. Default: 30.
SYNC_OBSERVABILITY_RETENTION_DAYS=30

# HEALTH_SYNC_LIGHT_MAX_AGE_MINUTES: stale threshold for the public light-sync health endpoint. Format: positive integer minutes. Default: 180.
HEALTH_SYNC_LIGHT_MAX_AGE_MINUTES=180

# HEALTH_SYNC_FOLLOWER_MAX_AGE_MINUTES: stale threshold for the public follower-sync health endpoint. Format: positive integer minutes. Default: 1080.
HEALTH_SYNC_FOLLOWER_MAX_AGE_MINUTES=1080

# HEALTH_SYNC_MONITORING_TOKEN: optional token for protected detailed sync health checks. Send as x-monitoring-token. Default: empty.
HEALTH_SYNC_MONITORING_TOKEN=

# TELEGRAM_BOT_TOKEN: optional Telegram bot token for owner alerts and reports. Format: bot token string. Default: empty.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: optional Telegram chat destination for alerts and reports. Format: chat ID string. Default: empty.
TELEGRAM_CHAT_ID=

# TELEGRAM_PROXY_PAGE_LABEL: DEPRECATED transition-only fallback used only when the entire SERVICE_EGRESS_PROXY_* tuple is absent. Format: existing page label. Default: empty.
TELEGRAM_PROXY_PAGE_LABEL=

# TELEGRAM_REPORT_HOUR: UTC hour for the scheduled Telegram daily revenue report. Format: integer 0-23. Default: 9.
TELEGRAM_REPORT_HOUR=9

# SERVICE_EGRESS_PROXY_*: boot-only SOCKS5 identity shared by Telegram and ElevenLabs. Configure all three together. URL must have an explicit port and no inline auth/path/query/fragment. Values below are non-working examples only.
SERVICE_EGRESS_PROXY_URL=socks5://proxy.example.internal:1080
SERVICE_EGRESS_PROXY_USERNAME=fake-service-user
SERVICE_EGRESS_PROXY_PASSWORD=fake-service-password

# OFAPI_API_KEY: optional onlyfansapi.com API key for the admin webhook registration flow. Format: key starting with ofapi_. Default: empty (registration endpoint returns 503).
OFAPI_API_KEY=

# OFAPI_BASE_URL: onlyfansapi.com API base URL. Format: URL. Default: https://app.onlyfansapi.com/api.
OFAPI_BASE_URL=https://app.onlyfansapi.com/api

# OFAPI_EVENT_RETENTION_DAYS: retention window for the fact-bearing OFAPI webhook journal. Lowering this value schedules irreversible deletion. Format: positive integer days. Runtime default: 36500.
OFAPI_EVENT_RETENTION_DAYS=36500

# OFAPI_DM_PROJECTION_ENABLED: project OFAPI message webhooks into page DM conversations/messages for mapped OnlyFans pages (live DM ingest, no REST credits). Format: true|false. Default: false.
OFAPI_DM_PROJECTION_ENABLED=false

# OFAPI_DM_SYNC_ENABLED: run the credit-budgeted OFAPI REST bootstrap/reconcile of OnlyFans DMs through the sync executor for OFAPI-mapped pages. Format: true|false. Default: false.
OFAPI_DM_SYNC_ENABLED=false

# OF Mirror export artifacts are downloaded by an operator into this absolute
# host directory and mounted read-only into API/worker for checksum-verified
# import. Create it before deploy with mode 0700; artifact CSVs must be 0600.
OFAPI_EXPORT_ARTIFACT_HOST_DIR=/opt/agency-hub-artifacts/ofapi-export
OFAPI_EXPORT_ARTIFACT_DIR=/var/lib/agency-hub/ofapi-export-artifacts

# OFAPI_REST_DELAY_MS: minimum spacing between OFAPI REST requests (client-wide pacing). Format: integer ms >= 0. Default: 500.
OFAPI_REST_DELAY_MS=500

# OFAPI_DM_BOOTSTRAP_MAX_REQUESTS_PER_RUN: OFAPI REST request cap per executor chunk run for the DM bootstrap/reconcile handlers. Format: integer >= 1. Default: 25.
OFAPI_DM_BOOTSTRAP_MAX_REQUESTS_PER_RUN=25

# OFAPI_DM_DAILY_CREDIT_BUDGET: UTC-day ceiling on the retired legacy DM REST sync path. Dedicated audience/backfill lanes keep their own ceilings and share the mirror physical cap below. Format: integer >= 1. Default: 500.
OFAPI_DM_DAILY_CREDIT_BUDGET=500

# OFAPI_MIRROR_GLOBAL_DAILY_CREDIT_BUDGET: UTC-day physical ceiling shared by governed mirror reads and dedicated legacy audience/backfill lanes. Format: integer >= 1. Default: 7000.
OFAPI_MIRROR_GLOBAL_DAILY_CREDIT_BUDGET=7000

# OFAPI_MIRROR_PRINCIPAL_DAILY_CALL_CAP: per-user UTC-day call cap for governed interactive mirror reads. Format: integer >= 1. Default: 4000.
OFAPI_MIRROR_PRINCIPAL_DAILY_CALL_CAP=4000

# OFAPI_MIRROR_PRINCIPAL_DAILY_CREDIT_CAP: per-user UTC-day reserved-credit cap for governed interactive mirror reads. Format: integer >= 1. Default: 4000.
OFAPI_MIRROR_PRINCIPAL_DAILY_CREDIT_CAP=4000

# OFAPI_MIRROR_INTERACTIVE_CAPTURE_ENABLED: first Decision #158 rollout gate; captures gateway reads durably before parsing or serving. Requires OFAPI_DESKTOP_READ_GATEWAY_ENABLED. Format: true|false. Default: false.
OFAPI_MIRROR_INTERACTIVE_CAPTURE_ENABLED=false

# OFAPI_MIRROR_BACKGROUND_CAPTURE_ENABLED: second Decision #158 rollout gate; drains only explicit durable mirror jobs. Requires interactive capture. Format: true|false. Default: false.
OFAPI_MIRROR_BACKGROUND_CAPTURE_ENABLED=false

# OFAPI_MESSAGE_HISTORY_SHADOW_ENABLED: third Decision #158 rollout gate; compares certified deep-history reads while the captured vendor response remains authoritative. Requires interactive capture. Format: true|false. Default: false.
OFAPI_MESSAGE_HISTORY_SHADOW_ENABLED=false

# OFAPI_CREDIT_FLOOR: hard floor on the last-observed OFAPI credit balance; all non-critical OFAPI REST stops below it. Format: integer >= 0. Default: 500.
OFAPI_CREDIT_FLOOR=500

# OFAPI_DM_RECONCILE_INTERVAL_MINUTES: how often the chats page-1 reconcile runs per page after bootstrap completes. Format: positive integer minutes. Default: 360 (6h).
OFAPI_DM_RECONCILE_INTERVAL_MINUTES=360

# OFAPI_ACCOUNT_HEALTH_ENABLED: project accounts.* webhook events into pages.ofapi_auth_status, show OFAPI auth in the connection block, and send debounced Telegram alerts (auth states, low credits, webhook silence). Format: true|false. Default: false.
OFAPI_ACCOUNT_HEALTH_ENABLED=false

# OFAPI_CREDIT_ALERT_THRESHOLD: alert when the last-observed OFAPI credit balance drops below this. Format: integer >= 0 (0 disables the alert). Default: 1000.
OFAPI_CREDIT_ALERT_THRESHOLD=1000

# OFAPI_WEBHOOK_SILENCE_THRESHOLD_MINUTES: alert when no OFAPI webhook events have been journaled for this long while mapped pages exist (conservative default to avoid quiet-night false positives). Format: positive integer minutes. Default: 720 (12h).
OFAPI_WEBHOOK_SILENCE_THRESHOLD_MINUTES=720

# OFAPI_CREDIT_LEDGER_ENABLED: append-only OFAPI credit ledger + webhook accrual + balance reconciliation + burn-rate alert (docs/ofapi-parity-plan.md Phase 1). Format: true|false. Default: false.
OFAPI_CREDIT_LEDGER_ENABLED=false

# OFAPI_BURN_ALERT_CREDITS_PER_HOUR: alert when trailing-hour credit spend (all sources except refills) exceeds this. Format: integer >= 0 (0 disables). Default: 300.
OFAPI_BURN_ALERT_CREDITS_PER_HOUR=300
# OFAPI_CREDIT_MICRO_USD_PRICE: display-only flat price per OFAPI credit for the credits dashboard's USD estimates. Format: integer micro-USD (1,000,000 = $1.00; e.g. 10000 = $0.01/credit). 0 hides USD estimates. Does not gate spend. Default: 0.
OFAPI_CREDIT_MICRO_USD_PRICE=0

# OFAPI_BALANCE_PING_ENABLED: one cheap (1 credit) daily request at 00:05 UTC purely to observe the credit balance so reconciliation has anchors on no-traffic days. Requires OFAPI_CREDIT_LEDGER_ENABLED. Format: true|false. Default: false.
OFAPI_BALANCE_PING_ENABLED=false

# OFAPI_AUDIENCE_SYNC_ENABLED: OFAPI audience sweep — subscribers for OnlyFans pages mapped to an OFAPI account, plus the live subscriptions.new/renewed projection (docs/ofapi-parity-plan.md Phase 3). Format: true|false. Default: false.
OFAPI_AUDIENCE_SYNC_ENABLED=false

# OFAPI_AUDIENCE_MAX_REQUESTS_PER_RUN: per-chunk request cap for the audience sweep. Format: positive integer. Default: 25.
OFAPI_AUDIENCE_MAX_REQUESTS_PER_RUN=25

# OFAPI_AUDIENCE_DAILY_CREDIT_BUDGET: UTC-day credit ceiling for the audience sweep (own ceiling so the sweep can never starve DM sync). Format: positive integer. Default: 300.
OFAPI_AUDIENCE_DAILY_CREDIT_BUDGET=300

# OFAPI_AUDIENCE_SWEEP_INTERVAL_MINUTES: cadence of the full fans/active sweep per page. Format: positive integer minutes. Default: 1440 (daily).
OFAPI_AUDIENCE_SWEEP_INTERVAL_MINUTES=1440

# OFAPI_PRESENCE_PROJECTION_ENABLED: project users.online/offline webhook events (and message-payload lastSeen) into fan presence for OnlyFans pages; the workboard presence panel then serves OnlyFans pages read-only (docs/ofapi-parity-plan.md Phase 4). Format: true|false. Default: false.
OFAPI_PRESENCE_PROJECTION_ENABLED=false

# OFAPI_DESKTOP_READ_GATEWAY_ENABLED: expose the chatter-key, page-scoped, GET-only OFAPI compatibility gateway at /api/v1/ofapi/read. Requires OFAPI_CREDIT_LEDGER_ENABLED. Desktop direct mode remains the rollback path until write commands migrate. Format: true|false. Default: false.
OFAPI_DESKTOP_READ_GATEWAY_ENABLED=false

# CHATMUSE_AI_GATEWAY_ENABLED: expose the default-off chatter-key AI gateway route at /api/v1/ai/gateway/stream. When true and ANTHROPIC_API_KEY is present, core can execute Anthropic provider streams through the gateway; local desktop provider keys are still the rollback path until production validation passes. Format: true|false. Default: false.
CHATMUSE_AI_GATEWAY_ENABLED=false

# CHATMUSE_AI_GATEWAY_DAILY_REQUEST_LIMIT: per chatter/page UTC-day request cap for the AI gateway preflight. 0 blocks provider attempts. Format: integer >= 0. Default: 200.
CHATMUSE_AI_GATEWAY_DAILY_REQUEST_LIMIT=200

# CHATMUSE_AI_GATEWAY_DAILY_MICRO_USD_LIMIT: per chatter/page UTC-day cost cap in micro-USD for the AI gateway preflight. 5,000,000 = $5.00; 0 blocks provider attempts. Format: integer >= 0. Default: 5000000.
CHATMUSE_AI_GATEWAY_DAILY_MICRO_USD_LIMIT=5000000

# ONLYFANS_TOP_SPENDERS_ENABLED: top_spenders stream for OnlyFans pages — monthly gross/net rankings computed from the existing transactions table (zero OFAPI credits; docs/ofapi-parity-plan.md Phase 5). Format: true|false. Default: false.
ONLYFANS_TOP_SPENDERS_ENABLED=false
