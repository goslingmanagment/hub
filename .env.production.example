# Agency Hub production template.
# Copy this file to .env.production, then replace the placeholder values before the first deploy.
# Keep API_PORT=3000 if you use docker-compose.production.yml without modification.
# Leave optional values blank to disable the related feature.

# POSTGRES_DB: bundled Postgres database name. Format: plain string. Default: agency_hub_core.
POSTGRES_DB=agency_hub_core

# POSTGRES_USER: bundled Postgres user name. Format: plain string. Default: postgres.
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: bundled Postgres password. Format: plain string. Default: none; set explicitly.
POSTGRES_PASSWORD=change-me

# DATABASE_URL: application database DSN for API, worker, CLI, and startup migrations. Format: postgres://USER:PASSWORD@HOST:PORT/DB. Default: none; required.
DATABASE_URL=postgres://postgres:change-me@postgres:5432/agency_hub_core

# APP_ENCRYPTION_KEY: write key for encrypted credentials and proxy secrets. Format: base64 that decodes to exactly 32 bytes. Default: none; required.
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-byte-key

# APP_ENCRYPTION_KEY_RING: optional legacy decrypt keys. Format: version:base64[,version:base64...]. Default: empty.
APP_ENCRYPTION_KEY_RING=

# APP_ENCRYPTION_KEY_VERSION: write-key version stored with new encrypted rows. Format: positive integer. Default: 1.
APP_ENCRYPTION_KEY_VERSION=1

# LOG_LEVEL: runtime log verbosity. Format: pino level string. Default: info.
LOG_LEVEL=info

# API_HOST: bind address inside the container. Format: host or IP string. Default: 0.0.0.0.
API_HOST=0.0.0.0

# API_PORT: HTTP port used by the API and same-origin dashboard. Format: positive integer. Default: 3000.
API_PORT=3000

# TRUST_PROXY: trust x-forwarded-* headers from the TLS reverse proxy. Format: true or false. Use true for the default production TLS proxy setup.
TRUST_PROXY=true

# SESSION_TTL_DAYS: dashboard session lifetime. Format: positive integer days. Default: 30.
SESSION_TTL_DAYS=30

# FANSLY_BASE_URL: Fansly API base URL. Format: absolute URL. Default: https://apiv3.fansly.com/api/v1.
FANSLY_BASE_URL=https://apiv3.fansly.com/api/v1

# ONLYMONSTER_BASE_URL: OnlyMonster API base URL for OnlyFans syncs. Format: absolute URL. Default: https://omapi.onlymonster.ai.
ONLYMONSTER_BASE_URL=https://omapi.onlymonster.ai

# SYNC_HTTP_TRACE_FILE: optional NDJSON request trace sink for sync HTTP telemetry. Format: writable file path inside the container. Default: empty.
SYNC_HTTP_TRACE_FILE=

# FANSLY_DEFAULT_DELAY_MS: primary per-request spacing for Fansly traffic. Format: positive integer milliseconds. Default: 1900.
FANSLY_DEFAULT_DELAY_MS=1900

# FANSLY_GLOBAL_DELAY_MS: deprecated fallback alias for FANSLY_DEFAULT_DELAY_MS. Format: positive integer milliseconds. Default: empty.
FANSLY_GLOBAL_DELAY_MS=

# FANSLY_ACCOUNT_LOOKUP_DELAY_MS: deprecated fallback alias kept for compatibility. Format: positive integer milliseconds. Default: empty.
FANSLY_ACCOUNT_LOOKUP_DELAY_MS=

# FOLLOWER_PAGE_DELAY_MS: delay between Fansly follower pages. Format: positive integer milliseconds. Default: 5000.
FOLLOWER_PAGE_DELAY_MS=5000

# FANSLY_DM_CONVERSATIONS_DELAY_MS: shared-rate-limit spacing for Fansly conversation syncs. Format: positive integer milliseconds. Default: 5000. Values below 5000 are raised to 5000.
FANSLY_DM_CONVERSATIONS_DELAY_MS=5000

# FANSLY_DM_MESSAGES_DELAY_MS: shared-rate-limit spacing for Fansly message syncs. Format: positive integer milliseconds. Default: 5000. Values below 5000 are raised to 5000.
FANSLY_DM_MESSAGES_DELAY_MS=5000

# FANSLY_DM_DEEP_BACKFILL_ENABLED: opt-in slow historical message backfill after live message work is exhausted. Format: true or false. Default: false.
FANSLY_DM_DEEP_BACKFILL_ENABLED=false

# FANSLY_DM_DEEP_BACKFILL_MAX_REQUESTS_PER_RUN: maximum historical message pages to fetch per dm_messages stream run when deep backfill is enabled. Format: non-negative integer. Default: 1.
FANSLY_DM_DEEP_BACKFILL_MAX_REQUESTS_PER_RUN=1

# FANSLY_DM_DEEP_BACKFILL_LIVE_REQUESTS_PER_DEEP: busy-account balance; after this many live message page requests, allow one deep page. Format: positive integer. Default: 4.
FANSLY_DM_DEEP_BACKFILL_LIVE_REQUESTS_PER_DEEP=4

# FANSLY_DM_DEEP_BACKFILL_CONTINUATION_DELAY_MS: idle deep-backfill delay between historical pages. Format: non-negative integer milliseconds. Default: 0.
FANSLY_DM_DEEP_BACKFILL_CONTINUATION_DELAY_MS=22000

# FANSLY_DM_DEEP_BACKFILL_CONTINUATION_JITTER_MS: random +/- jitter applied to idle deep-backfill continuation delay. Format: non-negative integer milliseconds. Default: 0.
FANSLY_DM_DEEP_BACKFILL_CONTINUATION_JITTER_MS=8000

# ONLYFANS_DEFAULT_DELAY_MS: baseline delay for OnlyFans adapter calls. Format: positive integer milliseconds. Default: 1000.
ONLYFANS_DEFAULT_DELAY_MS=1000

# ONLYFANS_PUBLIC_PROFILE_RESOLUTION_ENABLED: opt-in fallback for unresolved OnlyFans fan identities via public onlyfans.com/u<ID> pages. Requires ONLYFANS_PUBLIC_PROFILE_PROXY_URL unless ONLYFANS_PUBLIC_PROFILE_ALLOW_DIRECT=true; never uses page/account proxies. Format: true or false. Default: false.
ONLYFANS_PUBLIC_PROFILE_RESOLUTION_ENABLED=false

# ONLYFANS_PUBLIC_PROFILE_ALLOW_DIRECT: allow public-profile resolver to use the server IP when no dedicated proxy is configured. This still uses an empty browser context with no account cookies. Format: true or false. Default: false.
ONLYFANS_PUBLIC_PROFILE_ALLOW_DIRECT=false

# ONLYFANS_PUBLIC_PROFILE_PROXY_URL: dedicated public-profile resolver proxy. Must not be an account-hosting IP/proxy. Format: socks5://user:pass@host:port, http://user:pass@host:port, or user:pass@host:port. Default: empty.
ONLYFANS_PUBLIC_PROFILE_PROXY_URL=

# ONLYFANS_PUBLIC_PROFILE_MAX_PER_RUN: maximum public OnlyFans profile lookups per fan identity sync run. Format: positive integer. Default: 5.
ONLYFANS_PUBLIC_PROFILE_MAX_PER_RUN=5

# ONLYFANS_PUBLIC_PROFILE_DELAY_MS: delay between public OnlyFans profile lookups. Format: positive integer milliseconds. Default: 30000.
ONLYFANS_PUBLIC_PROFILE_DELAY_MS=30000

# SYNC_SHARED_RATE_LIMIT_ENABLED: enable shared Fansly pacing across workers/pages. Format: true or false. Runtime default: false. Recommended when executor concurrency is greater than 1.
SYNC_SHARED_RATE_LIMIT_ENABLED=true

# SYNC_PAGE_EXECUTOR_CONCURRENCY: number of pages the worker may execute in parallel. Format: positive integer. Default: 4.
SYNC_PAGE_EXECUTOR_CONCURRENCY=4

# TRANSACTION_LOOKBACK_DAYS: transaction resync lookback window. Format: positive integer days. Default: 7.
TRANSACTION_LOOKBACK_DAYS=7

# TRANSACTION_RESCAN_CAP_DAYS: maximum age of pending-aware transaction rescans. Format: positive integer days. Default: 30.
TRANSACTION_RESCAN_CAP_DAYS=30

# SYNC_OBSERVABILITY_RETENTION_DAYS: retention window for sync telemetry rows. Format: positive integer days. Default: 30.
SYNC_OBSERVABILITY_RETENTION_DAYS=30

# HEALTH_SYNC_LIGHT_MAX_AGE_MINUTES: stale threshold for the public light-sync health endpoint. Format: positive integer minutes. Default: 180.
HEALTH_SYNC_LIGHT_MAX_AGE_MINUTES=180

# HEALTH_SYNC_FOLLOWER_MAX_AGE_MINUTES: stale threshold for the public follower-sync health endpoint. Format: positive integer minutes. Default: 1080.
HEALTH_SYNC_FOLLOWER_MAX_AGE_MINUTES=1080

# HEALTH_SYNC_MONITORING_TOKEN: optional token for protected detailed sync health checks. Send as x-monitoring-token. Default: empty.
HEALTH_SYNC_MONITORING_TOKEN=

# TELEGRAM_BOT_TOKEN: optional Telegram bot token for owner alerts and reports. Format: bot token string. Default: empty.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: optional Telegram chat destination for alerts and reports. Format: chat ID string. Default: empty.
TELEGRAM_CHAT_ID=

# TELEGRAM_REPORT_HOUR: UTC hour for the scheduled Telegram daily revenue report. Format: integer 0-23. Default: 9.
TELEGRAM_REPORT_HOUR=9

# OFAPI_API_KEY: optional onlyfansapi.com API key for the admin webhook registration flow. Format: key starting with ofapi_. Default: empty (registration endpoint returns 503).
OFAPI_API_KEY=

# OFAPI_BASE_URL: onlyfansapi.com API base URL. Format: URL. Default: https://app.onlyfansapi.com/api.
OFAPI_BASE_URL=https://app.onlyfansapi.com/api

# OFAPI_EVENT_RETENTION_DAYS: retention window for the OFAPI webhook event journal (bounds SSE Last-Event-ID replay). Format: positive integer days. Default: 7.
OFAPI_EVENT_RETENTION_DAYS=7

# OFAPI_DM_PROJECTION_ENABLED: project OFAPI message webhooks into page DM conversations/messages for mapped OnlyFans pages (live DM ingest, no REST credits). Format: true|false. Default: false.
OFAPI_DM_PROJECTION_ENABLED=false

# OFAPI_DM_SYNC_ENABLED: run the credit-budgeted OFAPI REST bootstrap/reconcile of OnlyFans DMs through the sync executor for OFAPI-mapped pages. Format: true|false. Default: false.
OFAPI_DM_SYNC_ENABLED=false

# OFAPI_REST_DELAY_MS: minimum spacing between OFAPI REST requests (client-wide pacing). Format: integer ms >= 0. Default: 500.
OFAPI_REST_DELAY_MS=500

# OFAPI_DM_BOOTSTRAP_MAX_REQUESTS_PER_RUN: OFAPI REST request cap per executor chunk run for the DM bootstrap/reconcile handlers. Format: integer >= 1. Default: 25.
OFAPI_DM_BOOTSTRAP_MAX_REQUESTS_PER_RUN=25

# OFAPI_DM_DAILY_CREDIT_BUDGET: UTC-day ceiling on OFAPI credits spent by DM REST sync across all pages; runs yield gracefully when reached. Format: integer >= 1. Default: 500.
OFAPI_DM_DAILY_CREDIT_BUDGET=500

# OFAPI_CREDIT_FLOOR: hard floor on the last-observed OFAPI credit balance; all non-critical OFAPI REST stops below it. Format: integer >= 0. Default: 500.
OFAPI_CREDIT_FLOOR=500

# OFAPI_DM_RECONCILE_INTERVAL_MINUTES: how often the chats page-1 reconcile runs per page after bootstrap completes. Format: positive integer minutes. Default: 360 (6h).
OFAPI_DM_RECONCILE_INTERVAL_MINUTES=360
