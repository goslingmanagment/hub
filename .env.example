# Local host development only.
# For Docker Compose production deploys, copy .env.production.example to .env.production instead.
# Unset values use the runtime defaults from packages/shared/src/config.ts.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/agency_hub_core
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_ENCRYPTION_KEY_RING=
APP_ENCRYPTION_KEY_VERSION=1
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000
# Required when running behind a TLS-terminating reverse proxy so the app honors
# X-Forwarded-Proto and marks session cookies Secure. Defaults to false.
# Prefer a hop count (1 = the single proxy in front) or an IP/CIDR allowlist
# over true: true trusts the whole x-forwarded-for chain and lets clients
# spoof request.ip, which the login rate limiter keys on. The trusted proxy
# must append the real client address to x-forwarded-for.
# TRUST_PROXY=1
SESSION_TTL_DAYS=30
FANSLY_BASE_URL=https://apiv3.fansly.com/api/v1
SYNC_HTTP_TRACE_FILE=
SYNC_HTTP_ATTEMPT_TRACE_STDOUT=false
FANSLY_DEFAULT_DELAY_MS=1900
FOLLOWER_PAGE_DELAY_MS=5000
FANSLY_DM_CONVERSATIONS_DELAY_MS=5000
FANSLY_DM_MESSAGES_DELAY_MS=5000
FANSLY_DM_DEEP_BACKFILL_ENABLED=false
FANSLY_DM_DEEP_BACKFILL_MAX_REQUESTS_PER_RUN=1
FANSLY_DM_DEEP_BACKFILL_LIVE_REQUESTS_PER_DEEP=4
FANSLY_DM_DEEP_BACKFILL_CONTINUATION_DELAY_MS=22000
FANSLY_DM_DEEP_BACKFILL_CONTINUATION_JITTER_MS=8000
ONLYFANS_DEFAULT_DELAY_MS=1000
ONLYFANS_PUBLIC_PROFILE_RESOLUTION_ENABLED=false
ONLYFANS_PUBLIC_PROFILE_ALLOW_DIRECT=false
ONLYFANS_PUBLIC_PROFILE_PROXY_URL=
ONLYFANS_PUBLIC_PROFILE_MAX_PER_RUN=5
ONLYFANS_PUBLIC_PROFILE_DELAY_MS=30000
SYNC_SHARED_RATE_LIMIT_ENABLED=true
SYNC_PAGE_EXECUTOR_CONCURRENCY=4
TRANSACTION_LOOKBACK_DAYS=7
TRANSACTION_RESCAN_CAP_DAYS=30
SYNC_OBSERVABILITY_RETENTION_DAYS=30
HEALTH_SYNC_LIGHT_MAX_AGE_MINUTES=180
HEALTH_SYNC_FOLLOWER_MAX_AGE_MINUTES=1080
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_HOUR=9
# Boot-only SOCKS5 identity shared by Telegram and ElevenLabs. All three values
# must be present together; credentials must not be embedded in the URL. These
# values are fake/non-working: replace or clear all three together.
SERVICE_EGRESS_PROXY_URL=socks5://proxy.example.internal:1080
SERVICE_EGRESS_PROXY_USERNAME=fake-service-user
SERVICE_EGRESS_PROXY_PASSWORD=fake-service-password
OFAPI_API_KEY=
OFAPI_BASE_URL=https://app.onlyfansapi.com/api
OFAPI_EVENT_RETENTION_DAYS=36500
OFAPI_DM_PROJECTION_ENABLED=false
OFAPI_DM_SYNC_ENABLED=false
OFAPI_REST_DELAY_MS=500
OFAPI_DM_BOOTSTRAP_MAX_REQUESTS_PER_RUN=25
OFAPI_DM_DAILY_CREDIT_BUDGET=500
OFAPI_MIRROR_GLOBAL_DAILY_CREDIT_BUDGET=7000
OFAPI_MIRROR_PRINCIPAL_DAILY_CALL_CAP=4000
OFAPI_MIRROR_PRINCIPAL_DAILY_CREDIT_CAP=4000
OFAPI_MIRROR_INTERACTIVE_CAPTURE_ENABLED=false
OFAPI_MIRROR_BACKGROUND_CAPTURE_ENABLED=false
OFAPI_MESSAGE_HISTORY_SHADOW_ENABLED=false
OFAPI_CREDIT_FLOOR=500
OFAPI_DM_RECONCILE_INTERVAL_MINUTES=360
OFAPI_ACCOUNT_HEALTH_ENABLED=false
OFAPI_CREDIT_ALERT_THRESHOLD=1000
OFAPI_WEBHOOK_SILENCE_THRESHOLD_MINUTES=720
OFAPI_CREDIT_LEDGER_ENABLED=false
OFAPI_BURN_ALERT_CREDITS_PER_HOUR=300
OFAPI_CREDIT_MICRO_USD_PRICE=0
OFAPI_BALANCE_PING_ENABLED=false
OFAPI_AUDIENCE_SYNC_ENABLED=false
OFAPI_AUDIENCE_MAX_REQUESTS_PER_RUN=25
OFAPI_AUDIENCE_DAILY_CREDIT_BUDGET=300
OFAPI_AUDIENCE_SWEEP_INTERVAL_MINUTES=1440
OFAPI_PRESENCE_PROJECTION_ENABLED=false
ONLYFANS_TOP_SPENDERS_ENABLED=false

# ── WP-F1: the Fansly `stats_snapshot` lane ──────────────────────────────────
# Account statistics, the earnings mix, tracking links, discovery tag counters,
# and the mass-DM/poll/recap surface. Ships INERT: the flag is off and the
# allowlist FAILS CLOSED (empty = NO pages — the OPPOSITE of
# FANSLY_NEW_STREAM_PAGE_ALLOWLIST, where empty means every page).
FANSLY_STATS_SNAPSHOT_SYNC_ENABLED=false
FANSLY_STATS_SNAPSHOT_PAGE_ALLOWLIST=
# HTTP ATTEMPTS (retries included) per page per UTC day. Crossing it DEFERS the
# lane to the next day; a response already fetched is always journaled first.
FANSLY_STATS_SNAPSHOT_DAILY_CALL_BUDGET=25
# The trailing-25h period=3600000 step. 5-minute buckets are a deliberate non-goal.
FANSLY_STATS_HOURLY_ENABLED=true
FANSLY_STATS_HOURLY_BACKFILL_MAX_DAYS=30
# Delay + 30% jitter between BACKFILL chunk continuations only. Burst shape, not
# daily volume, is the real ban-risk surface.
FANSLY_BACKFILL_CONTINUATION_DELAY_MS=20000

# ── WP-F2: the Fansly `notifications` lane ───────────────────────────────────
# The head poll (48/day) plus the one-off deep backfill. This is the ONLY
# permanently-lossy lane: a liker, a reply or a quote is announced once and
# never re-served, so downtime here costs facts, not freshness. Ships INERT —
# the flag is off and the allowlist FAILS CLOSED (empty = NO pages).
FANSLY_NOTIFICATIONS_SYNC_ENABLED=false
FANSLY_NOTIFICATIONS_PAGE_ALLOWLIST=
# HTTP ATTEMPTS (retries included) per page per UTC day. 48 head polls plus
# pagination is the expected load; crossing the cap DEFERS to the next UTC day
# and never drops a response already fetched.
FANSLY_NOTIFICATIONS_DAILY_CALL_BUDGET=96

# ── WP-F3: the Fansly `catalog` lane ─────────────────────────────────────────
# The daily inventory sweep: both vaults, subscription tiers (the price truth is
# plans[].price, not tier.price), gift codes, automated messages, walls, and the
# vault media walk that MEASURES M — the count of unique media offers WP-F4 is
# sized against. No media bytes, no delivery URLs. Ships INERT — the flag is off
# and the allowlist FAILS CLOSED (empty = NO pages).
FANSLY_CATALOG_SYNC_ENABLED=false
FANSLY_CATALOG_PAGE_ALLOWLIST=
# HTTP ATTEMPTS (retries included) per page per UTC day. Six fixed steps plus the
# vault walk and the two batch hydrations share this one cap, so a first-enable
# exhaustion crawl spreads over days by design; crossing the cap DEFERS to the
# next UTC day and never drops a response already fetched.
FANSLY_CATALOG_DAILY_CALL_BUDGET=60

# ── WP-F5: the Fansly `post_replies` lane ────────────────────────────────────
# The comment archive: `GET /post/{postId}/replies` walked over the whole post
# back-catalogue, full bodies stored. A BARE GET — the browser's preceding
# `POST /postreply/verify` is NEVER issued ([E1] passed; §1 excludes
# write-shaped calls to the platform). Ships INERT — the flag is off and the
# allowlist FAILS CLOSED (empty = NO pages).
FANSLY_POST_REPLIES_SYNC_ENABLED=false
FANSLY_POST_REPLIES_PAGE_ALLOWLIST=
# HTTP ATTEMPTS (retries included) per page per UTC day. One walk = one call, so
# this is also how many posts a page re-reads per day: at 100 the biggest live
# page (1 318 roots) first-passes in ~14 days. Crossing the cap DEFERS to the
# next UTC day and never drops a response already fetched. The raise to 300 has
# its own criteria and its own window (decision #228); 400 is the ceiling.
FANSLY_REPLIES_DAILY_CALL_BUDGET=100
# How old a post's last walk must be before the round-robin re-reads it. This
# does NOT change egress — the budget above is the only thing that does — it
# changes which posts the budget is spent on.
FANSLY_REPLIES_REWALK_CYCLE_DAYS=14
# WP-F6: the decayed `GET /post?ids=` engagement refresh phase on the EXISTING
# `posts` stream. Off = the posts lane behaves exactly as before. The cap is
# counted in HTTP ATTEMPTS per page per UTC day, separately from the timeline
# walk, and DEFERS to the next day; one call re-reads up to 100 posts.
FANSLY_POST_ENGAGEMENT_REFRESH_ENABLED=false
FANSLY_POST_ENGAGEMENT_DAILY_CALL_BUDGET=40

# ── WP-F7: the Fansly `payouts` lane ─────────────────────────────────────────
# Money OUT: `GET /payments/payoutmethods` and `GET /payments/payout/requests`,
# two routes, both read-only. `/account/wallets/earnings` is NOT here (it is
# already the adapter's `getEarningsOverview`) and neither is the wallet
# earnings LEDGER — that is the existing `transactions` stream, verified by
# transaction id (A28-1/A28-8). Ships INERT — the flag is off and the allowlist
# FAILS CLOSED (empty = NO pages).
FANSLY_PAYOUTS_SYNC_ENABLED=false
FANSLY_PAYOUTS_PAGE_ALLOWLIST=
# HTTP ATTEMPTS (retries included) per page per UTC day. Steady state is TWO —
# one payout-method listing and one head page of the request history. The rest
# is headroom for the one-off offset walk that reaches the floor: 83 requests at
# a page size of 10 is nine calls. Crossing the cap DEFERS to the next UTC day
# and never drops a response already fetched.
FANSLY_PAYOUTS_DAILY_CALL_BUDGET=20

# ── WP-F4: the Fansly `media_stats` lane ─────────────────────────────────────
# Per-media traffic: `GET /it/moie/statsnew?mediaOfferId&beforeDate&afterDate&
# period`, asked once per media per window over the WHOLE catalogue at an
# age-decayed cadence (fresh <=30 d daily, mid 31-180 d weekly, long tail every
# LONG_TAIL_CYCLE_DAYS, round-robin by last visit). Nothing is dropped at any
# catalogue size; the cap decides how OFTEN the long tail comes round, not
# whether it does. Ships INERT — the flag is off and the allowlist FAILS CLOSED
# (empty = NO pages).
FANSLY_MEDIA_STATS_SYNC_ENABLED=false
FANSLY_MEDIA_STATS_PAGE_ALLOWLIST=
# HTTP ATTEMPTS (retries included) per page per UTC day. THIS LANE IS BUILT TO
# SATURATE ITS CAP: at M = 2 000 media the decay wants 294 calls a day (A16), so
# 300 is spent nearly every day and the long tail cycles in ~26 days. At
# M = 5 000 the decay wants 394 and the long tail becomes QUARTERLY (96 days).
# Crossing the cap DEFERS to the next UTC day and never drops a response already
# fetched. Raising it toward what the decay wants is a NAMED per-lane step, one
# value at a time, owner-approved, backed out on any 429. The lane REPORTS the
# live cycle in its progress block — never read it off a document.
FANSLY_MEDIA_STATS_DAILY_CALL_BUDGET=300
# How old a long-tail item's last visit must be before the round-robin re-reads
# it. This does NOT change egress — the budget above is the only thing that does
# — it changes which media the budget is spent on. The fresh (<=30 d) and mid
# (<=180 d) boundaries are constants in the code, deliberately: they describe
# how traffic decays with age, not a rate anyone should be tuning.
FANSLY_MEDIA_STATS_LONG_TAIL_CYCLE_DAYS=30

# ── Decision 347: unified chatter account ────────────────────────────────────
# Kill switch for the PUBLIC invite / password-reset link routes
# (/api/v1/auth/links/inspect and /redeem). false = they answer 404; the owner
# can still create links in the console. Live (config_settings), no restart.
# Format: true|false. Default: true.
ACCOUNT_LINKS_ENABLED=true
