# Local host development only.
# For Docker Compose production deploys, copy .env.production.example to .env.production instead.
# Unset values use the runtime defaults from packages/shared/src/config.ts.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/agency_hub_core
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_ENCRYPTION_KEY_RING=
APP_ENCRYPTION_KEY_VERSION=1
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000
# Required when running behind a TLS-terminating reverse proxy so the app honors
# X-Forwarded-Proto and marks session cookies Secure. Defaults to false.
# Prefer a hop count (1 = the single proxy in front) or an IP/CIDR allowlist
# over true: true trusts the whole x-forwarded-for chain and lets clients
# spoof request.ip, which the login rate limiter keys on. The trusted proxy
# must append the real client address to x-forwarded-for.
# TRUST_PROXY=1
SESSION_TTL_DAYS=30
FANSLY_BASE_URL=https://apiv3.fansly.com/api/v1
SYNC_HTTP_TRACE_FILE=
SYNC_HTTP_ATTEMPT_TRACE_STDOUT=false
FANSLY_DEFAULT_DELAY_MS=2500
ONLYFANS_DEFAULT_DELAY_MS=1000
ONLYFANS_PUBLIC_PROFILE_RESOLUTION_ENABLED=false
ONLYFANS_PUBLIC_PROFILE_ALLOW_DIRECT=false
ONLYFANS_PUBLIC_PROFILE_PROXY_URL=
ONLYFANS_PUBLIC_PROFILE_MAX_PER_RUN=5
ONLYFANS_PUBLIC_PROFILE_DELAY_MS=30000
SYNC_PAGE_EXECUTOR_CONCURRENCY=4
SYNC_OBSERVABILITY_RETENTION_DAYS=30
HEALTH_SYNC_LIGHT_MAX_AGE_MINUTES=180
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_HOUR=9
# Boot-only SOCKS5 identity shared by Telegram and ElevenLabs. All three values
# must be present together; credentials must not be embedded in the URL. These
# values are fake/non-working: replace or clear all three together.
SERVICE_EGRESS_PROXY_URL=socks5://proxy.example.internal:1080
SERVICE_EGRESS_PROXY_USERNAME=fake-service-user
SERVICE_EGRESS_PROXY_PASSWORD=fake-service-password
OFAPI_API_KEY=
OFAPI_BASE_URL=https://app.onlyfansapi.com/api
OFAPI_EVENT_RETENTION_DAYS=36500
OFAPI_DM_PROJECTION_ENABLED=false
OFAPI_DM_SYNC_ENABLED=false
OFAPI_REST_DELAY_MS=500
OFAPI_DM_BOOTSTRAP_MAX_REQUESTS_PER_RUN=25
OFAPI_DM_DAILY_CREDIT_BUDGET=500
OFAPI_MIRROR_GLOBAL_DAILY_CREDIT_BUDGET=7000
OFAPI_MIRROR_PRINCIPAL_DAILY_CALL_CAP=4000
OFAPI_MIRROR_PRINCIPAL_DAILY_CREDIT_CAP=4000
OFAPI_MIRROR_INTERACTIVE_CAPTURE_ENABLED=false
OFAPI_MIRROR_BACKGROUND_CAPTURE_ENABLED=false
OFAPI_MESSAGE_HISTORY_SHADOW_ENABLED=false
OFAPI_CREDIT_FLOOR=500
OFAPI_DM_RECONCILE_INTERVAL_MINUTES=360
OFAPI_ACCOUNT_HEALTH_ENABLED=false
OFAPI_CREDIT_ALERT_THRESHOLD=1000
OFAPI_WEBHOOK_SILENCE_THRESHOLD_MINUTES=720
OFAPI_WEBHOOK_AUTO_REDELIVERY_ENABLED=false
OFAPI_WEBHOOK_AUTO_REDELIVERY_DAILY_CAP=1000
OFAPI_MEDIA_DAILY_CAP_CREDITS=100
OFAPI_CREDIT_LEDGER_ENABLED=false
OFAPI_BURN_ALERT_CREDITS_PER_HOUR=300
OFAPI_CREDIT_MICRO_USD_PRICE=0
OFAPI_BALANCE_PING_ENABLED=false
OFAPI_AUDIENCE_SYNC_ENABLED=false
OFAPI_AUDIENCE_MAX_REQUESTS_PER_RUN=25
OFAPI_AUDIENCE_DAILY_CREDIT_BUDGET=300
OFAPI_AUDIENCE_SWEEP_INTERVAL_MINUTES=1440
OFAPI_PRESENCE_PROJECTION_ENABLED=false
ONLYFANS_TOP_SPENDERS_ENABLED=false

# ── The Fansly content resources ─────────────────────────────────────────────
# The Fansly Sync Engine paces stats, notifications, the catalog, post replies,
# payouts, per-media stats and the post engagement refresh from its registry;
# the legacy lanes' stream flags, page allowlists and daily call budgets are
# gone (step 4).
# How old a post's last replies walk must be before the round-robin re-reads it.
# It does NOT change the request rate; it changes which posts the walk reads.
FANSLY_REPLIES_REWALK_CYCLE_DAYS=14
# Arena "vanished chat" R5: the session-less public account reader (off at
# rest; it also needs its own proxy: `pnpm cli sync public-lookup proxy set`)
# and the Fansly ids it asks per request (1-100).
# FANSLY_PUBLIC_LOOKUP_ENABLED=false
# FANSLY_PUBLIC_LOOKUP_BATCH_SIZE=100

# ── Decision 349: unified chatter account ────────────────────────────────────
# Kill switch for the PUBLIC invite / password-reset link routes
# (/api/v1/auth/links/inspect and /redeem). false = they answer 404; the owner
# can still create links in the console. Live (config_settings), no restart.
# Format: true|false. Default: true.
ACCOUNT_LINKS_ENABLED=true

# ── Chat extension (chat-extension hub plan H-2b) ────────────────────────────
# The owner's switches for the OnlyFans chat extension. Live and audited: the
# owner edits them in the console (config_settings), no restart; each rests OFF.
# A JSON or version value that does not parse turns the extension off.
# CHAT_EXTENSION_ENABLED=false
# CHAT_EXTENSION_FEATURES={}
# CHAT_EXTENSION_MIN_VERSION=0.0.0
# CHAT_EXTENSION_HOST_BINDINGS={}
# CHAT_EXTENSION_PREVIEW_SEND_RECEIPT_PROFILES=[]
# Whether the fresh text the extension reads off the open OnlyFans chat joins
# the AI transcript: off|shadow|serve. Keep the env at off; the owner steps it
# off -> shadow -> serve in the console. A page also needs its freshText flag.
# AI_LIVE_TEXT_CONTEXT_MODE=off
# How many messages a full Recap of an OnlyFans chat may read: 1500|3000.
# Keep the env at 1500; the owner raises it in the console after the read plans
# and the cost were checked on production.
# AI_TRANSCRIPT_DEEP_MAX_ROWS=1500
# H-11b: keep the extension's client_health reports as hourly rollups with no
# user in them (the report itself is never stored). Off = accepted and dropped.
# CHAT_EXTENSION_HEALTH_INGEST_ENABLED=false
