{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@agency_hub_core/shared": ["../shared/src/browser.ts"],
      "@agency_hub_core/contracts": ["../contracts/src/index.ts"],
      "@kernel/sdk": ["../sdk/src/index.ts"],
      "@agency_hub_core/look/*": ["../look/src/*"],
      "@agency_hub_core/ui/*": ["../ui/src/*"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["core.ts", "world.ts", "fixtures/**/*.ts"]
}
