{
  "name": "agency_hub_core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "api": "node --import tsx/esm apps/runtime/src/api.ts",
    "build": "pnpm typecheck && pnpm --dir apps/dashboard build",
    "cli": "node --import tsx/esm apps/runtime/src/cli.ts",
    "contracts:generate": "node --import tsx/esm packages/contracts/src/generate.ts",
    "worker": "node --import tsx/esm apps/runtime/src/worker.ts",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:migrate": "node --import tsx/esm packages/db/src/migrate.ts",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "dev:db": "docker compose up -d postgres",
    "dev:dashboard": "cd apps/dashboard && npx vite"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.0",
    "testcontainers": "^11.7.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "argon2": "^0.44.0",
    "fastify": "^5.8.2",
    "fastify-type-provider-zod": "^6.1.0",
    "openapi-typescript": "^7.13.0",
    "pg-boss": "^12.14.0",
    "zod-to-json-schema": "^3.25.1",
    "@fastify/static": "^8.1.0"
  }
}
