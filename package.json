{
  "name": "agency_hub_core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "yaml": "2.8.3",
      "brace-expansion@^2.0.0": "2.0.3",
      "brace-expansion@^5.0.0": "5.0.6"
    }
  },
  "scripts": {
    "api": "node --import tsx/esm apps/runtime/src/api.ts",
    "api:watch": "node --import tsx/esm --watch apps/runtime/src/api.ts",
    "worker:watch": "node --import tsx/esm --watch apps/runtime/src/worker.ts",
    "build": "pnpm typecheck && pnpm --dir apps/dashboard build",
    "build:production": "pnpm typecheck && pnpm build:artifacts",
    "build:artifacts": "node scripts/build-production.mjs && pnpm --dir apps/dashboard build",
    "cli": "node --import tsx/esm apps/runtime/src/cli.ts",
    "hub": "node --import tsx/esm packages/hub-agent-cli/src/cli.ts",
    "contracts:generate": "node --import tsx/esm packages/contracts/src/generate.ts",
    "worker": "node --import tsx/esm apps/runtime/src/worker.ts",
    "db:generate": "node scripts/db-generate-disabled.mjs",
    "db:migrate": "node --import tsx/esm packages/db/src/migrate.ts",
    "analytics:run": "node scripts/analytics-run.mjs",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --exclude tests/**/*.integration.test.ts --exclude tests/schema-guard.test.ts --exclude tests/http-client.test.ts --exclude tests/network.test.ts",
    "test:prerequisites": "pnpm test:sync-critical",
    "test:sync-critical": "pnpm test:sync-critical:db && pnpm test:sync-critical:api",
    "test:sync-critical:db": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --no-file-parallelism tests/*.integration.test.ts tests/schema-guard.test.ts tests/http-client.test.ts tests/network.test.ts --exclude tests/api.integration.test.ts",
    "test:sync-critical:api": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --no-file-parallelism tests/api.integration.test.ts --testNamePattern \"\\\\[sync-critical\\\\]\"",
    "test:api:full": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --no-file-parallelism tests/api.integration.test.ts",
    "typecheck": "node scripts/check-strictness-ratchet.mjs",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck:ratchet-update": "node scripts/check-strictness-ratchet.mjs --update",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm --dir apps/dashboard build",
    "test:watch": "vitest",
    "dev": "bash scripts/dev-local.sh",
    "dev:db": "docker compose up -d postgres",
    "dev:dashboard": "cd apps/dashboard && npx vite"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/parser": "^8.62.1",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.25.12",
    "eslint": "^10.6.0",
    "pg": "8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "testcontainers": "^11.7.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "zod": "4.3.6"
  },
  "dependencies": {
    "@agency_hub_core/platform-core": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "argon2": "^0.44.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "pg-boss": "^12.14.0",
    "zod-to-json-schema": "^3.25.1"
  }
}
