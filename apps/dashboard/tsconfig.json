{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@fansly-connect/contracts": ["../../packages/contracts/src/index.ts"],
      "@fansly-connect/shared": ["../../packages/shared/src/browser.ts"]
    }
  },
  "include": ["src"]
}
