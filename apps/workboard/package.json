{
  "name": "@agency_hub_core/workboard",
  "private": true,
  "type": "module",
  "description": "Workboard: the owner's team-control app (shifts, people, what sells, decisions, payouts, access). Served by Hub under /workboard/; talks only to the Hub API.",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo --port 5190 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.17.0",
    "sonner": "^2.0.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  }
}
