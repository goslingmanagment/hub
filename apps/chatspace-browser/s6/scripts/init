#!/command/with-contenv sh
# Before the services (once per container start, as root): the profile
# volume is cs-firefox's; Firefox's policies name the extension's XPI the
# deploy script read from the update feed (CSB_EXTENSION_URL) — the
# extension updates itself from the feed after that (its update_url) —, and
# the state directory the watchdog and the health check share exists.
# A value that fails its check stops the container and is never printed.
set -eu
umask 022

fail() {
  echo "init: $*" >&2
  exit 1
}

URL="${CSB_EXTENSION_URL:-}"
case "$URL" in *"
"*) fail "the extension's XPI (CSB_EXTENSION_URL) is not one line" ;; esac
printf '%s\n' "$URL" | LC_ALL=C grep -Eqx -e 'https://ext\.gosling-agency\.ru/chat-extension/firefox/[A-Za-z0-9._-]+\.xpi' \
  || fail "the extension's XPI (CSB_EXTENSION_URL) is not one of the feed's"

install -d -o cs-firefox -g cs-firefox -m 700 /data/profile
install -d -m 755 /run/csb

# Firefox reads its policies from its install's distribution/ and from
# /etc/firefox/policies: the same file in both.
APP_DIR="$(dirname "$(readlink -f /usr/bin/firefox-esr)")"
[ -x "$APP_DIR/firefox-esr" ] || [ -x "$APP_DIR/firefox" ] || fail "no Firefox in $APP_DIR"
sed "s#@EXTENSION_URL@#$URL#" /opt/chatspace-browser/firefox/policies.json > /run/csb/policies.json
install -d -m 755 "$APP_DIR/distribution" /etc/firefox/policies
install -m 644 /run/csb/policies.json "$APP_DIR/distribution/policies.json"
install -m 644 /run/csb/policies.json /etc/firefox/policies/policies.json
rm -f /run/csb/policies.json
echo "init: Firefox $(firefox-esr --version 2>/dev/null | sed 's/^Mozilla Firefox //'), the extension from ${URL##*/}"
