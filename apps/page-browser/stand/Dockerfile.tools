# syntax=docker/dockerfile:1.7
# Project Browser — the stand's tools image (plan §5, stage 2; stage 3,
# PR 19). Everything of the stand that is not the page container runs in it:
# the stand's Fansly, the runner, the capture, the Docker proxy. The same
# Node as the page image, plus what those need from the system:
#
#   openssl, libnss3-tools   the stand's CA and the NSS database Chrome reads
#   tcpdump, iproute2        the capture on the page container's interfaces
#   busybox-static           `ip` and `sed` for the stand's entry inside the
#                            page container, whose image has neither
#   curl                     health checks
#
# No code of the stand is in the image: apps/page-browser is mounted read-only
# at /pb, so a series runs the committed tree it was started from.
#
#   docker build -t pb-suite/tools:<rev> -f apps/page-browser/stand/Dockerfile.tools apps/page-browser/stand
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl openssl libnss3-tools tcpdump iproute2 busybox-static procps \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /pb
CMD ["sleep", "infinity"]
