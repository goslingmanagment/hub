#!/bin/sh
# The container's health (the image's HEALTHCHECK; page.sh waits for it):
# the kernel check of the egress rules passed, and the X server — Chrome's
# display and the owner's screen — has been up for 5 s at least, not
# restarting. Chrome is the operator's to watch.
set -eu
grep -q '"ok":true' /run/pb/net-selftest.json
# shellcheck disable=SC2046
set -- $(/command/s6-svstat -o up,updownfor /run/service/xvnc)
[ "$1" = true ] && [ "$2" -ge 5 ]
[ -S /tmp/.X11-unix/X99 ]
